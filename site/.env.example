# Set to 1 to build entirely from committed content, with no network calls.
# This is the "dead Google" switch — see docs/RUNBOOK.md.
SHEETS_DISABLED=1

# Only needed by `npm run sync`, never by `npm run build`.
GOOGLE_SA_KEY_B64=
SHEET_ID=
DRIVE_IMAGES_FOLDER_ID=

# Public: the /exec address of apps-script/Form.gs, which emails each application to
# Dr. Regonda. Blank renders his email address and his four points instead of the form.
PUBLIC_JOIN_FORM_URL=
