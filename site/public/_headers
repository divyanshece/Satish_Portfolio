/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'none'; img-src 'self'; media-src 'self'; font-src 'self'; manifest-src 'self'; style-src 'self'; script-src 'none'; connect-src 'none'; form-action https://script.google.com https://script.googleusercontent.com; frame-ancestors 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Full-size image previews and untruncated snippets. Deliberately no
  # nosnippet: it is what keeps these pages eligible as a cited source.
  X-Robots-Tag: max-image-preview:large, max-snippet:-1, max-video-preview:-1
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
