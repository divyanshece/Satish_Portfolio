---
import { positions } from "../lib/content";

/**
 * Twenty years of appointments, drawn as a record on one time axis.
 *
 * He reads gauge records for a living, so his own career is set the same way:
 * a shared axis, one reach per place, and the reading that is still being
 * taken marked as live. The bar carries the chronology; the dateline beside it
 * carries the exact years, because a bar is a shape and a date is a fact.
 *
 * Two things this has to get right, because both were wrong the first time:
 *  - It groups by ORGANISATION, not by post. He has held four titles at IIT
 *    Hyderabad since February 2017, and the reach must span all of them rather
 *    than showing whichever row happens to sort first.
 *  - It orders by when each began, not by the display order /about/ uses.
 *
 * Washington and Baltimore overlap: he consulted for the World Bank while at
 * Johns Hopkins. In a line of type that overlap reads as a typing error. Drawn
 * on a shared axis it is simply what happened, and it is the interesting part.
 *
 * Geometry rides on SVG presentation attributes rather than inline style
 * attributes, which is what keeps the content security policy at
 * style-src 'self' with no inline exception.
 */

const NOW = new Date();
const END = NOW.getFullYear() + 1;
const START = 2006;
const SPAN = END - START;

/** Several organisations appear under more than one name in the record. */
const CANONICAL: Record<string, string> = {
  NOAA: "NOAA / NWS",
  "NWS / NOAA": "NOAA / NWS",
};

/** Only the four that carry the arc. Committee and chair roles live on /about/. */
const SHOWN = new Set(["NOAA / NWS", "World Bank", "Johns Hopkins University", "IIT Hyderabad"]);

/** "2017-02" → 2017.08, so a reach starts where the month actually falls. */
function decimal(ym: string): number {
  const [y, m] = ym.split("-");
  return Number(y) + (m ? (Number(m) - 1) / 12 : 0);
}

type Reach = { org: string; role: string; city: string; order: number; from: number; to: number; open: boolean };
const byOrg = new Map<string, Reach>();

for (const p of positions) {
  if (p.kind !== "appointment") continue;
  const org = CANONICAL[p.org] ?? p.org;
  if (!SHOWN.has(org)) continue;

  const from = decimal(p.start);
  const open = !p.end;
  const to = open ? NOW.getFullYear() + NOW.getMonth() / 12 : decimal(p.end) + 1 / 12;

  const seen = byOrg.get(org);
  if (!seen) {
    byOrg.set(org, { org, role: p.role, city: p.city ?? "", order: p.order, from, to, open });
  } else {
    /* One reach per place, spanning every post held there. The role shown is
       the one /about/ lists first, which is the senior or current title. */
    seen.from = Math.min(seen.from, from);
    seen.to = Math.max(seen.to, to);
    seen.open = seen.open || open;
    if (p.order < seen.order) {
      seen.role = p.role;
      seen.city = p.city ?? seen.city;
      seen.order = p.order;
    }
  }
}

const rows = [...byOrg.values()]
  .sort((a, b) => a.from - b.from)
  .map((r, i) => ({
    ...r,
    i,
    /* "Department of" is redundant beside the place; "Office of" is part of
       the unit's name and stays. */
    role: r.role.replace(/,\s*Department of\s*/i, ", "),
    years: `${Math.floor(r.from)}–${r.open ? "now" : Math.floor(r.to - 1 / 12)}`,
    x: ((r.from - START) / SPAN) * 100,
    w: Math.max(((r.to - r.from) / SPAN) * 100, 1.2),
  }));

const ticks = [2006, 2013, 2020, END - 1];
---

<figure class="traj">
  <div class="axis" aria-hidden="true">
    {ticks.map((t) => <span>{t}</span>)}
  </div>

  <ol class="reaches">
    {rows.map((r) => (
      <li class={`reach r${r.i}${r.open ? " live" : ""}`}>
        <p class="head">
          <span class="org">{r.org}</span>
          <span class="when">
            <span class="years">{r.years}</span>
            {/* The name of the last one already says where it is. */}
            {r.city && <span class="city">{r.city}</span>}
          </span>
        </p>

        <div class="track">
          <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <rect class="bar" x={r.x.toFixed(2)} y="1" width={r.w.toFixed(2)} height="6" />
            {/* The leading edge of a reading still being taken. A vertical
                mark rather than a dot, so the horizontal stretch of the
                track cannot deform it. */}
            {r.open && <rect class="head-mark" x={(r.x + r.w - 0.5).toFixed(2)} y="0" width="0.5" height="8" />}
          </svg>
        </div>

        <p class="role">{r.role}</p>
        <span class="visually-hidden">
          {Math.floor(r.from)}{r.open ? " to the present" : ` to ${Math.floor(r.to - 1 / 12)}`}
        </span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .traj {
    margin: var(--s-7) 0 0;
    max-width: 58rem;   /* it now runs the page's full column, not a half */
    /* The whole record is one scroll subject, so the reaches draw in sequence
       rather than each waiting for its own row to arrive. */
    view-timeline-name: --traj;
  }

  /* The axis: four figures on a hairline, the ends tucked inside it. */
  .axis {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: var(--t-micro);
    font-variant-numeric: tabular-nums;
    letter-spacing: .04em;
    color: var(--ink-mute);
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--s-2);
  }
  .axis span:first-child { margin-inline-start: -.15em; }
  .axis span:last-child { margin-inline-end: -.15em; }

  .reaches { list-style: none; margin: 0; padding: 0; }
  .reach { padding-block: var(--s-4) var(--s-3); border-bottom: 1px solid var(--rule); }
  .reach:last-child { border-bottom: 0; padding-bottom: 0; }

  .head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--s-4);
    margin: 0 0 var(--s-2);
  }
  /* The place, set as a name rather than as a tracked-out label. */
  .org { font-weight: 600; line-height: 1.3; }
  .when { text-align: right; display: grid; gap: .15rem; }
  .city {
    font-size: var(--t-meta);
    line-height: 1.3;
    color: var(--ink-mute);
    font-style: italic;
    white-space: nowrap;
  }
  .years {
    font-family: var(--mono);
    font-size: var(--t-micro);
    font-variant-numeric: tabular-nums;
    letter-spacing: .04em;
    color: var(--ink-mute);
    white-space: nowrap;
  }

  .track { height: 8px; }
  .track svg { display: block; width: 100%; height: 8px; overflow: visible; }
  .bar { fill: var(--ink); }
  .head-mark { fill: var(--signal); }

  .role {
    margin: var(--s-2) 0 0;
    font-size: var(--t-small);
    line-height: 1.4;
    color: var(--ink-mute);
    max-width: 34rem;
  }

  /* The post he holds now is the one thing here in colour. */
  .live .bar { fill: var(--signal); }
  .live .org { color: var(--signal); }
  .live .years { color: var(--signal); }

  @media (prefers-reduced-motion: no-preference) {
    /* The leading edge of the live reach breathes, the way a gauge that is
       still reporting does. It is the only thing on the page that never stops. */
    .head-mark { animation: traj-live 2.6s ease-in-out infinite; }

    @supports (animation-timeline: view()) {
      /* Each reach is traced from its own left edge, in the order they were
         held. transform-box keeps the origin on the rect, not the viewBox. */
      .bar {
        transform-box: fill-box;
        transform-origin: left center;
        transform: scaleX(0);
        animation: traj-draw linear both;
        animation-timeline: --traj;
      }
      .r0 .bar { animation-range: entry 10% entry 45%; }
      .r1 .bar { animation-range: entry 20% entry 55%; }
      .r2 .bar { animation-range: entry 30% entry 65%; }
      .r3 .bar { animation-range: entry 40% entry 80%; }

      .head, .role {
        animation: traj-rise linear both;
        animation-timeline: --traj;
      }
      .r0 .head, .r0 .role { animation-range: entry 4% entry 32%; }
      .r1 .head, .r1 .role { animation-range: entry 14% entry 42%; }
      .r2 .head, .r2 .role { animation-range: entry 24% entry 52%; }
      .r3 .head, .r3 .role { animation-range: entry 34% entry 62%; }

      /* The live mark appears only once its reach has been drawn to it. */
      .head-mark {
        animation:
          traj-live 2.6s ease-in-out infinite,
          traj-fade linear both;
        animation-timeline: auto, --traj;
        animation-range: normal, entry 80% entry 88%;
      }
    }
  }

  @keyframes traj-draw { to { transform: scaleX(1); } }
  @keyframes traj-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes traj-rise {
    from { opacity: 0; translate: 0 .4rem; }
    to   { opacity: 1; translate: 0 0; }
  }
  @keyframes traj-live {
    0%, 100% { opacity: 1; }
    50%      { opacity: .25; }
  }

  @media (max-width: 640px) {
    .traj { margin-top: var(--s-6); }
    .head { gap: var(--s-3); }
    .role { font-size: var(--t-meta); }
  }
</style>
