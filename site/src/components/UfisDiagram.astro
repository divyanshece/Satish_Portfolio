---
/**
 * The Urban Flood Information System, drawn as a catchment.
 *
 * Every picture and every word here is the group's own, from their UFIS
 * slide. The four stages are panels on the site's paper; what runs between
 * them is water. Two tributaries leave the inputs and converge into one
 * stem that enters the models — a pool. The outlet divides into two
 * distributaries that enter the tools; two channels leave the tools and
 * converge into one outfall that enters policy. One dashed, counter-current channel runs back
 * beneath, the slide's own up-arrow. Water tucks under each panel's edge, so
 * it is seen to enter and leave, and it never crosses a picture. Convergence
 * is the arrow; the still needs none.
 *
 * Only water is coloured. Everything else is ink on plate and paper, in the
 * site's type. The stages are numbered because they are a sequence.
 *
 * Geometry and timing live in src/lib/ufis-layout.mjs; scripts/ufis-coords.mjs
 * turns them into src/styles/ufis-coords.css (the tiles' percentage boxes,
 * the bead's window on every channel, when each ripple opens, when each
 * panel fills). The SVG below is built from the same module, so the drawing
 * and its clock can never drift apart.
 *
 * Motion, all CSS and all behind prefers-reduced-motion. As the board
 * scrolls into view the panels settle and the water draws itself in, left to
 * right. Then one story plays every twelve seconds: a bead leaves each input
 * (a ring opens at the port), the streams merge and the bead enters the
 * models — the panel fills with the pool tint, its numeral turns, rain falls
 * on the forecast, the terrain lifts, the network breathes — then it
 * re-emerges into the delta and spreads among the tools (the panel fills;
 * the maps and the dashboard refresh), gathers into the outfall and reaches
 * policy, whose panel fills and whose pictures lift; then a packet runs home
 * along the return. A slow glint rides every channel in between. The
 * pictures move only when the bead reaches them. Under 64rem the same panels
 * stack down a single channel and fill in the same order.
 */
import "../styles/ufis-coords.css";
import UfisArt from "./UfisArt.astro";
import { BOARD, PANELS, HAIRLINE, CHANNELS, RETURN, RIPPLES } from "../lib/ufis-layout.mjs";

const viewBox = `0 0 ${BOARD.w} ${BOARD.h}`;
const water = [...CHANNELS, RETURN];
---

<figure class="ufis">
  <div class="board">
    <svg class="net" viewBox={viewBox} aria-hidden="true" focusable="false">
      <g class="channels">
        {CHANNELS.map((c) => <path class={`ch r-${c.r} sw-${c.width}`} d={c.d} pathLength="1" />)}
      </g>
      <path class="ret" d={RETURN.d} />
      <path class="chev" d={RETURN.chevron} />
      <g class="glides">
        {CHANNELS.map((c) => <path class="glide" d={c.d} />)}
      </g>
      <g class="pulses">
        {water.map((c) => <path class={`halo sw-${c.width} w-${c.id}`} d={c.d} pathLength="1" />)}
        {water.map((c) => <path class={`bead sw-${c.width} w-${c.id}`} d={c.d} pathLength="1" />)}
      </g>
      <g class="panels">
        {Object.entries(PANELS).map(([k, [x, y, w, h]]) => (
          <rect class={`panel pn-${k}`} x={x} y={y} width={w} height={h} />
        ))}
        {Object.entries(PANELS).map(([k, [x, , w]]) => (
          <line class={`hair hr-${k}`} x1={x} y1={HAIRLINE.y} x2={x + w} y2={HAIRLINE.y} />
        ))}
      </g>
      <g class="ripples">
        {RIPPLES.map(([x, y], i) => (
          <>
            <circle class={`ripple rp-${i}`} cx={x} cy={y} r="6" />
            <circle class={`ripple two rp-${i}`} cx={x} cy={y} r="6" />
          </>
        ))}
      </g>
    </svg>

    <section class="stage s1">
      <h3 class="hd k-hd-1"><span class="num">1</span> Data Inputs</h3>
      <div class="row">
        <p class="grp k-g-1">Observation &amp; Sensing</p>
        <div class="item">
          <UfisArt id="satellite" />
          <p class="lbl k-l-satellite">Satellite</p>
        </div>
        <div class="item">
          <UfisArt id="aws" />
          <p class="lbl k-l-aws">Automatic Weather Stations</p>
        </div>
        <div class="item">
          <UfisArt id="hydromet" />
          <p class="lbl k-l-hydromet">Hydro-meteorological</p>
        </div>
      </div>
      <div class="row">
        <p class="grp k-g-2">Community &amp; Social Information</p>
        <div class="item">
          <span class="group k-snap">
            <UfisArt id="app-shot-a" />
            <UfisArt id="phone-frame" />
            <UfisArt id="varshamitra" />
          </span>
          <p class="lbl k-l-snap">SnapFlood<sup>&trade;</sup></p>
        </div>
        <div class="item">
          <UfisArt id="community" />
        </div>
        <div class="item">
          <span class="group k-socials">
            <UfisArt id="phone-black" />
            <UfisArt id="facebook" />
            <UfisArt id="bluesky" />
            <UfisArt id="x" />
            <UfisArt id="whatsapp" />
            <UfisArt id="linkedin" />
          </span>
        </div>
      </div>
      <div class="row">
        <p class="grp k-g-3">GeoSpatial &amp; Infrastructure Information</p>
        <div class="item">
          <UfisArt id="geospatial" />
        </div>
        <ul class="list k-list-geo">
          <li>Soil Map</li>
          <li>Streamflow Data</li>
          <li>Stormwater Network Data</li>
          <li>Digital Elevation Models</li>
          <li>Land Use Land Cover</li>
          <li>Road Networks</li>
        </ul>
      </div>
    </section>

    <section class="stage s2">
      <h3 class="hd k-hd-2"><span class="num">2</span> Models &amp; Forecasting</h3>
      <div class="row">
        <div class="item">
          <UfisArt id="weather" />
          <p class="lbl k-l-weather">Weather Forecasting Models</p>
        </div>
        <div class="item">
          <UfisArt id="hydro" />
          <p class="lbl k-l-hydro">Hydrological &amp; Hydraulic Models</p>
        </div>
        <div class="item">
          <span class="group k-ai">
            <UfisArt id="ai-network" />
            <UfisArt id="book-gears" />
            <UfisArt id="ai-head" />
          </span>
          <p class="lbl k-l-ai">AI/ML/DL Models</p>
        </div>
      </div>
    </section>

    <section class="stage s3">
      <h3 class="hd k-hd-3"><span class="num">3</span> Tools: Products &amp; Services</h3>
      <div class="row">
        <div class="item">
          <UfisArt id="map-rain" />
          <p class="lbl k-l-rain">Rainfall Maps</p>
        </div>
        <div class="item">
          <UfisArt id="map-uhi" />
          <p class="lbl k-l-uhi">UHI Maps</p>
        </div>
        <div class="item">
          <UfisArt id="map-risk" />
          <p class="lbl k-l-risk">Risk &amp; Vulnerability Maps</p>
        </div>
      </div>
      <div class="row">
        <div class="item">
          <UfisArt id="flood-map" />
          <p class="lbl k-l-flood">Flood Extents &amp; Inundation Map</p>
        </div>
      </div>
      <div class="row">
        <div class="item">
          <span class="group k-phones">
            <UfisArt id="app-shot-a-2" />
            <UfisArt id="phone-frame-2" />
            <UfisArt id="app-shot-b" />
            <UfisArt id="phone-frame-3" />
          </span>
          <p class="lbl k-l-phones">SnapFlood<sup>&trade;</sup> Mobile App</p>
        </div>
        <div class="item">
          <span class="group k-alerts">
            <UfisArt id="alert-phone" />
            <UfisArt id="telegram" />
            <UfisArt id="whatsapp-2" />
          </span>
          <p class="lbl k-l-alerts">Alerts via SMS/Social Media</p>
        </div>
      </div>
      <div class="row">
        <div class="item">
          <UfisArt id="dashboard" />
          <p class="lbl k-l-dash">Web Dashboards</p>
        </div>
      </div>
    </section>

    <section class="stage s4">
      <h3 class="hd k-hd-4"><span class="num">4</span> Decision Support &amp; Policy</h3>
      <div class="row">
        <div class="item">
          <UfisArt id="disaster" />
          <p class="lbl k-l-disaster">Disaster Management</p>
        </div>
        <div class="item">
          <UfisArt id="mitigation" />
          <p class="lbl k-l-mitigation">Mitigation Strategies &amp; Policy Making</p>
        </div>
        <div class="item">
          <UfisArt id="stakeholders" />
          <p class="lbl k-l-stakeholders">Stakeholders of Different Types</p>
        </div>
      </div>
    </section>
  </div>
</figure>

<style is:global>
  .ufis {
    margin: 0;
    container-type: inline-size;
    container-name: ufis;
    color: var(--ink);
    /* Only water is coloured: stops of the ramp --accent comes from.
       Moving data is --signal, the token the site reserves for exactly that. */
    --u-water: #3F8377;
    --u-glide: #A6D0C5;
    --u-pool: #D6E6DF;
    --loop: 12s;
  }
  .ufis .board {
    position: relative;
    aspect-ratio: 1200 / 620;
    container-type: inline-size;
    /* One board unit, in container units: every size below is "n board units". */
    --px: calc(100cqw / 1200);
    background: var(--paper);
    overflow: clip;
    view-timeline-name: --ufis;
  }

  /* The site's heading, paragraph and list styles must not reach in. */
  .ufis h3, .ufis p, .ufis ul { margin: 0; padding: 0; font: inherit; letter-spacing: 0; }
  .ufis sup { font-size: .6em; line-height: 0; vertical-align: super; }

  /* ---- Panels and water ------------------------------------------------- */
  .ufis .net { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .ufis .panel { fill: var(--plate); stroke: var(--rule); stroke-width: 1; }
  .ufis .hair { stroke: var(--rule); stroke-width: 1; }
  .ufis .ch { fill: none; stroke: var(--u-water); stroke-linecap: round; stroke-linejoin: round; }
  .ufis .sw-6 { stroke-width: 6; }
  .ufis .sw-9 { stroke-width: 9; }
  .ufis .ch.sw-9 { stroke-linecap: butt; }
  /* A soft centre-line gives the water its wet look; in motion it carries the glint. */
  .ufis .glide { fill: none; stroke: var(--u-glide); stroke-width: 2; stroke-linecap: round; opacity: .35; }
  .ufis .ret { fill: none; stroke: var(--u-water); stroke-width: 3; stroke-dasharray: 9 7; stroke-linecap: round; }
  .ufis .chev { fill: none; stroke: var(--u-water); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  /* The bead and the ripples exist only in motion; the still is the drawn network. */
  .ufis .pulses, .ufis .ripples { display: none; }
  /* A zero-length dash with round caps is a dot the size of the stroke on every path, whatever its length. */
  .ufis .bead, .ufis .halo { fill: none; stroke-linecap: round; stroke-dasharray: 0 2; stroke-dashoffset: .12; }
  .ufis .bead { stroke: var(--signal); }
  .ufis .halo { stroke: var(--u-pool); }
  .ufis .bead.sw-6 { stroke-width: 12; } .ufis .halo.sw-6 { stroke-width: 18; }
  .ufis .bead.sw-9 { stroke-width: 14; } .ufis .halo.sw-9 { stroke-width: 20; }
  .ufis .ripple { fill: none; stroke: var(--signal); stroke-width: 1.5; vector-effect: non-scaling-stroke; opacity: 0; transform-box: fill-box; transform-origin: center; }

  /* ---- Type ------------------------------------------------------------- */
  .ufis .board .hd, .ufis .board .grp, .ufis .board .lbl, .ufis .board .list,
  .ufis .board .art, .ufis .board .group { position: absolute; }
  /* Heads sit on the hairline whether they run to one line or two. */
  .ufis .board .hd { top: auto; bottom: calc(532 * var(--px)); }
  .ufis .hd { font-family: var(--serif); font-weight: 600; line-height: 1.2; text-align: center; text-wrap: balance; }
  .ufis .k-hd-2 { text-wrap: auto; }
  .ufis .num {
    font-family: var(--mono); font-weight: 500; font-size: .78em;
    color: var(--ink-mute); margin-right: .4em; font-variant-numeric: tabular-nums;
  }
  .ufis .grp { font-family: var(--serif); font-style: italic; font-weight: 600; color: var(--ink); line-height: 1.25; text-align: center; }
  .ufis .lbl { font-family: var(--serif); font-weight: 500; line-height: 1.22; text-align: center; text-wrap: balance; color: var(--ink-mute); }
  .ufis .list { font-family: var(--serif); font-weight: 500; line-height: 1.4; list-style: none; color: var(--ink-mute); }
  .ufis .list li::before { content: "\2022\00a0"; color: var(--u-water); }

  .ufis .art { display: block; }
  .ufis .art img { width: 100%; height: 100%; object-fit: contain; }
  .ufis .art video { display: none; position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ufis .group { display: block; }
  .ufis .k-map-rain, .ufis .k-map-uhi, .ufis .k-map-risk, .ufis .k-flood-map, .ufis .k-dashboard, .ufis .k-weather { overflow: hidden; }

  /* ---- Motion ----------------------------------------------------------- */
  @media (prefers-reduced-motion: no-preference) {
    .ufis .has-video img { visibility: hidden; }
    .ufis .has-video video { display: block; }

    /* One glint every 180 units, riding every channel ten times slower than the bead.
       stroke-dashoffset is inherited, so the group animates once for all twenty paths. */
    .ufis .glide { stroke-dasharray: 36 144; opacity: .55; }
    .ufis .glides { animation: ufis-glide 7.5s linear infinite; }

    /* The bead and its halo: the window on each channel comes from the layout (--cm). */
    .ufis .pulses, .ufis .ripples { display: block; }
    .ufis .bead, .ufis .halo {
      animation-name: var(--cm);
      animation-duration: var(--loop);
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }

    /* Two rings open where the bead meets a panel, a beat apart. */
    .ufis .ripple { animation: ufis-ripple var(--loop) linear infinite; animation-delay: calc(var(--at) * var(--loop)); }
    .ufis .ripple.two { animation-delay: calc(var(--at) * var(--loop) + .22s); }

    /* While the bead is inside a stage, that panel fills and its numeral turns
       (windows from the layout: --pool, --numk). */
    .ufis .panel {
      animation-name: var(--pool);
      animation-duration: var(--loop);
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }
    .ufis .num {
      animation-name: var(--numk);
      animation-duration: var(--loop);
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }

    /* Every picture moves while its panel is lit, and only then. Each stage's
       --at (from the layout) is the moment the bead arrives; each picture's
       keyframes put its move in the first 12% of the cycle and the delay
       holds it until that moment, staggered across the panel so the
       groups ripple through in sequence. --beat names the move; the defaults
       are wrapped in :where() so the per-picture choices win. */
    .ufis :where(.board .item > .art, .board .item > .group) { --beat: ufis-float; }
    .ufis :where(.board .group > .art) { --beat: none; }
    .ufis .board .item > .art, .ufis .board .item > .group, .ufis .board .group > .art {
      animation: var(--beat) var(--loop) linear infinite;
      animation-delay: calc(var(--at) * var(--loop));
    }
    /* 1 Data Inputs */
    .ufis .k-satellite { --beat: ufis-orbit; }
    .ufis .k-aws { --beat: ufis-sway; --at: .022; }
    .ufis .k-hydromet { --at: .034; }
    .ufis .k-snap { --at: .018; }
    .ufis .k-community { --beat: ufis-drift; --at: .03; }
    .ufis .k-socials { --beat: none; }
    .ufis .k-socials > .art { --beat: ufis-pop; }
    .ufis .k-phone-black { --beat: ufis-float; --at: .012; }
    .ufis .k-facebook { --at: .024; }
    .ufis .k-bluesky { --at: .036; }
    .ufis .k-x { --at: .048; }
    .ufis .k-whatsapp { --at: .06; }
    .ufis .k-linkedin { --at: .072; }
    .ufis .k-geospatial { --at: .046; }
    /* 2 Models & Forecasting */
    .ufis .k-hydro { --at: .16; }
    .ufis .k-ai { --beat: none; }
    .ufis .k-ai-network { --beat: ufis-breathe; --at: .15; }
    .ufis .k-book-gears { --beat: ufis-turn; --at: .165; }
    .ufis .k-ai-head { --beat: ufis-glow; --at: .18; }
    /* 3 Tools: Products & Services */
    .ufis .k-map-uhi { --at: .427; }
    .ufis .k-map-risk { --at: .442; }
    .ufis .k-flood-map { --at: .457; }
    .ufis .k-phones { --at: .43; }
    .ufis .k-alerts { --beat: none; }
    .ufis .k-alert-phone { --beat: ufis-ring; --at: .44; }
    .ufis .k-telegram { --beat: ufis-pop; --at: .458; }
    .ufis .k-whatsapp-2 { --beat: ufis-pop; --at: .472; }
    .ufis .k-dashboard { --at: .472; }
    /* 4 Decision Support & Policy */
    .ufis .k-mitigation { --at: .69; }
    .ufis .k-stakeholders { --at: .706; }

    /* Rain over the forecast tile while the bead is in the pool — one stripe
       period per cycle, so it never jumps (a video, when there is one, replaces it). */
    .ufis .k-weather::after {
      content: "";
      position: absolute;
      left: 14%; right: 14%; top: calc(34% - 19 * var(--px)); bottom: 26%;
      opacity: 0;
      background: repeating-linear-gradient(112deg, transparent 0 calc(6 * var(--px)), rgba(63, 131, 119, .5) calc(6 * var(--px)) calc(7 * var(--px)));
      animation: ufis-rain 1.1s linear infinite, ufis-window var(--loop) linear infinite;
      animation-delay: 0s, calc(var(--at) * var(--loop));
    }
    .ufis .has-video::after { content: none; }

    /* The products refresh in reading order as the bead reaches the tools. */
    .ufis .k-map-rain::after, .ufis .k-map-uhi::after, .ufis .k-map-risk::after, .ufis .k-flood-map::after, .ufis .k-dashboard::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(100deg, transparent 42%, rgba(255, 255, 255, .35) 50%, transparent 58%);
      transform: translateX(-100%);
      animation: ufis-sheen var(--loop) linear infinite;
      animation-delay: calc(var(--at) * var(--loop));
    }
    .ufis .k-map-uhi::after { --at: .43; }
    .ufis .k-map-risk::after { --at: .445; }
    .ufis .k-flood-map::after { --at: .46; }
    .ufis .k-dashboard::after { --at: .475; }

    /* As the board enters the viewport the panels settle and the water draws
       itself in, left to right; the story is at full strength once the board
       is framed. Base styles are the finished drawing, so engines without
       scroll timelines lose nothing. */
    @supports (animation-timeline: view()) {
      .ufis .panel {
        animation-name: var(--pool), ufis-settle;
        animation-duration: var(--loop), auto;
        animation-timing-function: linear, linear;
        animation-iteration-count: infinite, 1;
        animation-fill-mode: none, both;
        animation-timeline: auto, --ufis;
        animation-range: normal, entry 0% entry 20%;
      }
      .ufis .pn-s2 { animation-range: normal, entry 18% entry 38%; }
      .ufis .pn-s3 { animation-range: normal, entry 36% entry 56%; }
      .ufis .pn-s4 { animation-range: normal, entry 54% entry 74%; }
      .ufis .hair { animation: ufis-settle linear both; animation-timeline: --ufis; animation-range: entry 0% entry 20%; }
      .ufis .hr-s2 { animation-range: entry 18% entry 38%; }
      .ufis .hr-s3 { animation-range: entry 36% entry 56%; }
      .ufis .hr-s4 { animation-range: entry 54% entry 74%; }
      /* A dash one path long, parked beyond the start until the draw begins. */
      .ufis .ch { stroke-dasharray: 1 1.5; stroke-dashoffset: 1.1; animation: ufis-draw linear both; animation-timeline: --ufis; }
      .ufis .ch.r-g1 { animation-range: entry 22% entry 40%; }
      .ufis .ch.r-g2 { animation-range: entry 42% entry 58%; }
      .ufis .ch.r-g3 { animation-range: entry 60% entry 78%; }
      .ufis .ret, .ufis .chev { animation: ufis-fade linear both; animation-timeline: --ufis; animation-range: entry 78% entry 86%; }
      .ufis .glides, .ufis .pulses, .ufis .ripples { animation-name: ufis-fade; animation-fill-mode: both; animation-timeline: --ufis; animation-range: entry 84% entry 94%; }
      .ufis .glides {
        animation-name: ufis-glide, ufis-fade;
        animation-duration: 7.5s, auto;
        animation-timing-function: linear, linear;
        animation-iteration-count: infinite, 1;
        animation-fill-mode: none, both;
        animation-timeline: auto, --ufis;
        animation-range: normal, entry 84% entry 94%;
      }

      .ufis .board .hd, .ufis .board .grp, .ufis .board .lbl, .ufis .board .list {
        animation: ufis-rise linear both; animation-timeline: --ufis; animation-range: entry 4% entry 24%;
      }
      .ufis .s2 .hd, .ufis .s2 .lbl { animation-range: entry 22% entry 42%; }
      .ufis .s3 .hd, .ufis .s3 .lbl { animation-range: entry 40% entry 60%; }
      .ufis .s4 .hd, .ufis .s4 .lbl { animation-range: entry 58% entry 78%; }
      .ufis .num {
        animation-name: var(--numk), ufis-rise;
        animation-duration: var(--loop), auto;
        animation-timing-function: linear, linear;
        animation-iteration-count: infinite, 1;
        animation-fill-mode: none, both;
        animation-timeline: auto, --ufis;
        animation-range: normal, entry 4% entry 24%;
      }
      .ufis .s2 .num { animation-range: normal, entry 22% entry 42%; }
      .ufis .s3 .num { animation-range: normal, entry 40% entry 60%; }
      .ufis .s4 .num { animation-range: normal, entry 58% entry 78%; }

      .ufis .board .item > .art, .ufis .board .item > .group {
        animation-name: var(--beat), ufis-rise;
        animation-duration: var(--loop), auto;
        animation-timing-function: linear, linear;
        animation-iteration-count: infinite, 1;
        animation-fill-mode: none, both;
        animation-delay: calc(var(--at) * var(--loop)), 0s;
        animation-timeline: auto, --ufis;
        animation-range: normal, entry 4% entry 26%;
      }
      .ufis .s2 .item > .art, .ufis .s2 .item > .group { animation-range: normal, entry 22% entry 44%; }
      .ufis .s3 .item > .art, .ufis .s3 .item > .group { animation-range: normal, entry 40% entry 62%; }
      .ufis .s4 .item > .art, .ufis .s4 .item > .group { animation-range: normal, entry 58% entry 80%; }
    }
  }

  @keyframes ufis-glide { to { stroke-dashoffset: -180; } }
  @keyframes ufis-ripple {
    0% { opacity: .9; transform: scale(.3); animation-timing-function: cubic-bezier(.1, .7, .2, 1); }
    10% { opacity: 0; transform: scale(3.6); }
    100% { opacity: 0; transform: scale(3.6); }
  }

