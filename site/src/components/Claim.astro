---
/* No counts of papers or of funded projects, anywhere. His instruction, and
   his reasoning: a number beside a theme turns a body of work into a score and
   invites the reader to compare one line against another. Sorting by domain is
   useful; counting within it is not. */
import { FIGURE_SIZE } from "../lib/content";
import { hydronyms } from "../lib/text";

export interface Props { theme: any; linked?: boolean; headingLevel?: 2 | 3 }
const { theme, linked = true, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}`;
const href = `/research/${theme.slug}/`;
const fig = theme.figure ? `/figures/${theme.figure}` : null;
const [figW, figH] = FIGURE_SIZE[theme.figure] ?? [760, 546];
---
<article class="claim">
  <div>
    <H>{linked ? <a href={href}>{theme.title}</a> : theme.title}</H>
    <p>{theme.summary}</p>
  </div>
  {fig && (
    <figure>
      <div class="plate"><img src={fig} alt={theme.figure_alt} width={figW} height={figH} loading="lazy" decoding="async" /></div>
      <figcaption class="figcredit">
        <span set:html={hydronyms(theme.figure_caption ?? "")} />
        <span class="src">{theme.figure_credit}</span>
      </figcaption>
    </figure>
  )}
</article>

<style>
  .claim {
    display: grid; grid-template-columns: minmax(0, 1fr) 17rem;
    gap: var(--s-7); align-items: start;
    padding-block: var(--s-6); border-bottom: 1px solid var(--rule);
  }
  .claim:first-of-type { border-top: 1px solid var(--rule); }
  h2, h3 { font-size: var(--t-lead); line-height: 1.45; font-weight: 400; max-width: 29rem; }
  h2 a, h3 a { color: var(--ink); text-decoration-color: var(--rule-strong); }
  h2 a:hover, h3 a:hover { color: var(--accent); }
  p { margin-top: var(--s-3); font-size: var(--t-small); color: var(--ink-mute); max-width: 29rem; }
  @media (max-width: 980px) {
    .claim { grid-template-columns: 1fr; gap: var(--s-4); }
    .claim figure { max-width: 20rem; }
  }
</style>
