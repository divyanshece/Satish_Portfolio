---
import { ext } from "../lib/links";
/**
 * Home. Identity and routing in one screen.
 *
 * No `title` prop: Base owns the home title. Everything below is either his
 * approved words or derived from src/data — no total, count or year on this
 * page is typed by hand.
 */
import Base from "../layouts/Base.astro";
import Trajectory from "../components/Trajectory.astro";
import Intake from "../components/Intake.astro";
import Claim from "../components/Claim.astro";
import ProductRow from "../components/ProductRow.astro";
import PersonJsonLd from "../components/PersonJsonLd.astro";
import {
  settings,
  research,
  products,
  counts,
  fill,
  prose,
} from "../lib/content";
import { hydronyms, shortDate } from "../lib/text";

const description =
  "Dr. Satish K. Regonda, Associate Professor of Civil Engineering and Climate Change at " +
  "IIT Hyderabad: flood forecasting for Hyderabad and Indian river basins.";

/* The index of what he works on. Names only — see the note in Claim.astro on
   why nothing here is counted. The full claims are further down the page. */
const themeIndex = research.map((t) => ({ slug: t.slug, label: t.short }));

const PORTRAIT_ALT =
  "Dr. Satish K. Regonda at his desk in his office at IIT Hyderabad, working at a laptop, " +
  "with an irrigation map of Telangana pinned on the wall behind him and a globe " +
  "standing beside it.";


/* ---- products ------------------------------------------------------ */

const homeProducts = products.slice(0, 4);

/* ---- RAFT ---------------------------------------------------------- */

const raftSocials = Object.entries(settings.raft_socials);
const raftSite = settings.raft_site_url;
const raftSiteLabel = raftSite.replace(/^https?:\/\//, "").replace(/\/$/, "");
---

<Base description={description} ogType="profile">
  <Fragment slot="head"><PersonJsonLd /></Fragment>

  <div class="band band-deep">
    <div class="wide">
      <div class="ident">
        <div class="who">
          <h1>{settings.name_display ?? settings.name_full}</h1>
          <p class="post">
            {settings.title}<br />
            Departments of {settings.departments.join(" & ")}<br />
            {settings.institution}
          </p>

        </div>

        <figure class="port">
          <div class="plate">
            <img
              src="/img/portrait.jpg"
              alt={PORTRAIT_ALT}
              width="704"
              height="880"
              decoding="async"
            />
          </div>
        </figure>
      </div>
    </div>
  </div>

  <div class="wide">
    <div class="opening">
      <p class="lead" set:html={hydronyms(prose.bio_home[0])} />

      {themeIndex.length > 0 && (
        <nav class="works" aria-labelledby="h-works">
          <h2 id="h-works" class="micro">What I work on</h2>
          <ul>
            {themeIndex.map((t) => (
              <li>
                <a href={`/research/${t.slug}/`}>
                  <span class="wname">{t.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>

    <Trajectory />
  </div>

  {research.length > 0 && (
    <div class="wide">
      {/* The themes, and only the themes. The papers are one click away on
          /research/, and a list of recent titles here repeated that page. */}
      <section aria-labelledby="h-rp">
        <div class="sec-head">
          <h2 id="h-rp">Research themes</h2>
          <a class="sec-more" href="/research/">Research &amp; publications</a>
        </div>

        {research.map((t) => <Claim theme={t} />)}
      </section>
    </div>
  )}

  {homeProducts.length > 0 && (
    <div class="content">
      <section aria-labelledby="h-products">
        <div class="sec-head">
          <h2 id="h-products">Products</h2>
          <a class="sec-more" href="/products/">All {counts.products} products</a>
        </div>
        <p class="standfirst" set:html={hydronyms(fill(settings.products_standfirst, { n: counts.products }))} />
        {homeProducts.map((p) => <ProductRow product={p} />)}
      </section>
    </div>
  )}

  <div class="wide">
    <section aria-labelledby="h-raft">
      <div class="sec-head">
        <h2 id="h-raft">The RAFT group</h2>
        {raftSite && <a class="sec-more" href={raftSite} {...ext(raftSite)}>{raftSiteLabel}</a>}
      </div>

      <p class="prose lead">
        How much water will Indian cities and rivers see, and how soon can we tell anyone?
      </p>

      <p class="lead-sub">
        RAFT expands to Rainfall-runoff Analysis and Forecasting Tools. The group
        collects, models and forecasts rainfall and runoff for Indian cities and river
        basins.
      </p>

      {raftSite && (
        <p class="lead-sub">
          RAFT keeps its own site at <a href={raftSite} {...ext(raftSite)}>{raftSiteLabel}</a>, and posts
          from the accounts below.
        </p>
      )}

      {raftSocials.length > 0 && (
        <p class="meta lead-sub">
          {raftSocials.map(([label, url], i) => (
            <>{i > 0 && " · "}<a href={url} {...ext(url)}>{label}</a></>
          ))}
        </p>
      )}
    </section>
  </div>

  {/* Last, after the group it invites people into. The masthead stays about
      him; the notice is where a reader who has seen the work decides. */}
  <div class="wide">
    <Intake />
  </div>
</Base>

<style>

  /* ---------- the masthead ---------- */

  /* The one asymmetric grid on the site: the words get the long measure and
     the photograph takes the short column. The fact row is pushed to the foot
     of its column, so it lands on the same line as the bottom of the frame
     instead of leaving the band hanging open. */
  /* Three objects, not two: who he is, the rivers he forecasts, and his face.
     The map is portrait, which is what lets it fill the height the photograph
     sets instead of leaving the band hanging open below the text. */
  /* Two objects, not three: his name and his face. The river map that sat
     between them has gone, which is what lets both of them be bigger and the
     name stay on one line. */
  .ident {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 24rem;
    gap: var(--s-8);
    align-items: center;
  }
  .who { display: flex; flex-direction: column; }
  .who h1 { max-width: none; white-space: nowrap; }
  .post {
    font-size: var(--t-lead);
    line-height: 1.4;
    color: var(--tint);
    margin-top: var(--s-5);
  }
  .port { margin: 0; }

  /* ---------- the opening ---------- */

  /* His paragraph and the index of what it is about, side by side. The career
     record then runs the full width below both, because its axis is a span of
     twenty years and it was the one thing on this page short of room. */
  .opening {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--s-8);
    align-items: start;
    padding-block: var(--s-8) var(--s-7);
  }

  .works h2 { color: var(--ink-mute); padding-bottom: var(--s-3); }
  .works ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .works li { border-bottom: 1px solid var(--rule); }
  .works a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-4);
    text-decoration: none;
    color: var(--ink);
  }
  .works a:hover .wname { color: var(--accent); text-decoration: underline;
    text-decoration-thickness: .06em; text-underline-offset: .16em; }
  .wname { font-size: var(--t-lead); line-height: 1.3; }
  .wn {
    font-family: var(--mono);
    font-size: var(--t-micro);
    font-variant-numeric: tabular-nums;
    color: var(--ink-mute);
  }

  @media (max-width: 980px) {
    /* The name takes the full width and the two pictures share what is left
       evenly — at a phone's width an unequal split left the map a smudge. */
    .ident { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .who h1 { white-space: normal; }
    .port { max-width: 20rem; }
    .opening {
      grid-template-columns: 1fr;
      gap: var(--s-6);
      padding-block: var(--s-6);
    }
  }

</style>
