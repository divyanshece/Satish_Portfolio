---
import { ext } from "../lib/links";
import Base from "../layouts/Base.astro";
import { settings, prose, counts, products } from "../lib/content";
import { hydronyms } from "../lib/text";
import UfisDiagram from "../components/UfisDiagram.astro";
import PersonJsonLd from "../components/PersonJsonLd.astro";
import BandArt from "../components/BandArt.astro";

/**
 * About RAFT, not about its members. The group keeps its own site and its own
 * roster there; his students live at /students/ because they are his.
 *
 * All copy on this page is the group's own, supplied by them: the name, the
 * tagline, the mission, the goal paragraph and the list of research themes.
 */

const raftHost = settings.raft_site_url.replace(/^https?:\/\//, "").replace(/\/$/, "");
const socials = Object.entries(settings.raft_socials ?? {});

/* The store links live on the SnapFlood product record, so they are edited once. */
const snap = products.find((p) => p.slug === "snapflood");
const store = (label: string) => snap?.links?.find((l) => l.label === label)?.url;
const android = store("Google Play");
const ios = store("App Store");

const description =
  "RAFT Waters at IIT Hyderabad, led by Dr. Satish K. Regonda: rainfall-runoff analysis, " +
  "modelling and forecasting, and the Urban Flood Information System.";
---

<Base title="RAFT" description={description}>
  <Fragment slot="head"><PersonJsonLd page="/group/" /></Fragment>
  <div class="band band-deep">
    <div class="wide">
      <div class="ident">
        <div>
      <h1>{prose.raft_name}</h1>
      {/* What the letters stand for. The mission sentence that used to sit here
          is said again, in full, in the goal paragraph below. */}
      <p class="standfirst">{prose.raft_tagline}</p>

      <nav class="jump" aria-label="On this page">
        {prose.raft_themes.length > 0 && <a href="#themes">Research themes</a>}
        <a href="#ufis">UFIS</a>
        <a href="#site">The group's own site</a>
      </nav>
        </div>

        <BandArt art="raft" />
      </div>
    </div>
  </div>

  <div class="wide">

    <section class="about">
      <div class="goal">
        <p class="prose" set:html={hydronyms(prose.raft_goal)} />
      </div>
      {prose.raft_themes.length > 0 && (
        <div class="themes">
          <h2 id="themes">Research themes</h2>
          <ul>
            {prose.raft_themes.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      )}
    </section>
  </div>

  <div class="wide">
    <section id="ufis" class="system">
      <div class="sys-head">
        <h2>Urban Flood Information System (UFIS)</h2>
      </div>
      <UfisDiagram />
      <p class="meta after">
        <a href="/products/snapflood/">SnapFlood</a>, the app that feeds it, is live on{" "}
        {android ? <a href={android} {...ext(android)}>Android</a> : "Android"} and{" "}
        {ios ? <a href={ios} {...ext(ios)}>iOS</a> : "iOS"}.
      </p>
    </section>
  </div>

  <div class="wide">
    <section id="site" class="reach">
      <div class="sec-head"><h2>The group's own site</h2></div>
      <p class="prose intro">
        RAFT keeps its members, news and outreach at its own site.
      </p>

      {/* One plaque, not a Site / Email / Follow row — the footer a little way
          below is already three columns of labelled links, and a second set
          here read as a second footer. What the group is called and where it
          is, flush left; how to reach it, flush right. The two ends are pinned
          to the plaque's own edges, so the block fills the width because its
          content reaches both sides rather than because columns were stretched
          to get there. */}
      <div class="plaque">
        <div class="who">
          <a
            class="dom"
            href={settings.raft_site_url}
            {...ext(settings.raft_site_url)}
          >{raftHost}</a>
          {settings.raft_location && <p class="where">{settings.raft_location}</p>}
        </div>

        <div class="reachable">
          {settings.raft_email && (
            <a class="mail" href={`mailto:${settings.raft_email}`}>{settings.raft_email}</a>
          )}
          {socials.length > 0 && (
            <ul class="accounts">
              {socials.map(([name, url]) => <li><a href={url} {...ext(url)}>{name}</a></li>)}
            </ul>
          )}
        </div>
      </div>

      {/* A second hand-off, and a different destination: his students are his,
          so they are listed here rather than on the group's site. */}
      <p class="aside">
        The {counts.current} students working with me are listed under{" "}
        <a href="/students/">Teaching &amp; Students</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  /* The words on the left, the picture on the right. */
  .ident {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-8);
    align-items: center;
  }
  @media (max-width: 62rem) {
    .ident { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
  }

  /* ---- The group, in its own words ------------------------------------- */
  .band h1 { margin: 0 0 var(--s-5); }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--s-7) var(--s-9);
    padding-block: var(--s-7) var(--s-6);
  }
  .goal .prose { max-width: 36rem; margin: 0; }
  .themes h2 { font-size: var(--t-small); font-weight: 600; margin: 0 0 var(--s-3); }
  /* Twelve themes as a two-column list ruled like a specification, not as cards. */
  .themes ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0 var(--s-5);
  }
  .themes li {
    border-top: 1px solid var(--rule);
    padding: .55rem 0;
    font-size: var(--t-small);
    line-height: 1.35;
  }

  /* ---- The system ------------------------------------------------------ */
  .system { padding-block: var(--s-7) var(--s-4); }
  .sys-head { text-align: center; margin-bottom: var(--s-6); }
  .sys-head h2 {
    display: inline-block;
    margin: 0;
    padding-bottom: var(--s-3);
    border-bottom: 2px solid var(--accent);
    text-wrap: balance;
  }
  .after { margin-top: var(--s-5); color: var(--ink-mute); text-align: center; }

  /* ---- Reaching the group --------------------------------------------- */
  .reach { padding-block: var(--s-7) var(--s-4); }
  .intro { max-width: 36rem; margin: 0 0 var(--s-6); }

  /* Labels are dropped throughout: a domain and an email address caption
     themselves, and "Follow" is a word for a marketing page. The two halves
     are aligned on their first baseline, so the domain and the email sit on
     one line across the plaque. */
  .plaque {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, auto);
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-5) var(--s-6);
    background: var(--plate);
    border: 1px solid var(--rule-strong);
    padding: var(--s-6);
  }
  .dom {
    font-family: var(--serif);
    font-size: var(--t-h2);
    line-height: 1.2;
  }
  .where {
    margin: var(--s-3) 0 0;
    font-family: var(--mono);
    font-size: var(--t-meta);
    font-variation-settings: "wdth" 80;
    letter-spacing: .02em;
    line-height: 1.6;
    color: var(--ink-mute);
  }
  .reachable { text-align: end; }
  /* The email is an address, so it keeps the mono the office address uses;
     the accounts under it are names of places, so they keep the serif. */
  .mail {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: .02em;
  }
  .accounts {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--s-2) var(--s-5);
    font-size: .9375rem;
  }
  .aside { margin: var(--s-6) 0 0; max-width: 40rem; color: var(--ink-mute); }

  @media (max-width: 760px) {
    .about { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    /* Stacked, the right half turns back to the left and the gap between the
       two becomes a rule, because the shared edge no longer separates them. */
    .plaque { grid-template-columns: minmax(0, 1fr); gap: 0; padding: var(--s-5); }
    .reachable {
      text-align: start;
      margin-top: var(--s-5);
      padding-top: var(--s-5);
      border-top: 1px solid var(--rule);
    }
    .accounts { justify-content: flex-start; }
  }
  @media (max-width: 480px) {
    .themes ul { grid-template-columns: minmax(0, 1fr); }
  }
</style>
